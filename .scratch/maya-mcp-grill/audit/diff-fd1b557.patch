+        assert cmds.getAttr("LGT_keyShape.color") == [(1.0, 1.0, 1.0)]
+        assert cmds.objExists("LGT_keyShape.coneAngle")
+        assert not cmds.objExists("LGT_keyShape.bogusAttr")
+
+    def test_camera_and_aim(self, scene):
