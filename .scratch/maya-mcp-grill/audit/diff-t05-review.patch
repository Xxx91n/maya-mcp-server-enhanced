+        frame = len(data).to_bytes(FRAME_HEADER_SIZE, "big") + data
+        self.socket.write(frame)
+        self.socket.flush()
+
+    def close(self) -> None:
+        if self.closed:
+            return
+        self.closed = True
+        try:
+            self.socket.disconnectFromHost()
